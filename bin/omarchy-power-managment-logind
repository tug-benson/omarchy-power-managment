#!/usr/bin/env python3
"""logind helper — get / set IdleAction / HandleLidSwitch via drop-in + pkexec.

Get: parses `systemd-analyze cat-config systemd/logind.conf` (fallback to /etc/systemd/logind.conf)
Set: writes /etc/systemd/logind.conf.d/10-omarchy-power-managment.conf via pkexec-wrapped invocation.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DROPIN_PATH = "/etc/systemd/logind.conf.d/10-omarchy-power-managment.conf"
DROPIN_DIR = "/etc/systemd/logind.conf.d"

DEFAULTS = {
    "HandlePowerKey": "ignore",
    "HandleLidSwitch": "suspend",
    "HandleLidSwitchExternalPower": "suspend",
    "HandleLidSwitchDocked": "ignore",
    "IdleAction": "ignore",
    "IdleActionSec": "30min",
}

LID_ALLOWED = {"ignore", "suspend", "hibernate", "poweroff", "lock"}
IDLE_ALLOWED = {"ignore", "suspend", "suspend-then-hibernate", "hibernate", "poweroff", "lock"}

def parse_logind_text(text):
    vals = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r'^(\w+)\s*=\s*(.+)$', line)
        if m:
            k = m.group(1).strip()
            v = m.group(2).strip().split("#")[0].strip()
            vals[k] = v
    return vals

def get_effective():
    # try systemd-analyze cat-config
    text = ""
    try:
        text = subprocess.check_output(["systemd-analyze", "cat-config", "systemd/logind.conf"], text=True, stderr=subprocess.DEVNULL, timeout=3)
    except Exception:
        try:
            text = Path("/etc/systemd/logind.conf").read_text()
        except Exception:
            text = ""
        # also try drop-in if exists
        try:
            if Path(DROPIN_PATH).exists():
                text += "\n" + Path(DROPIN_PATH).read_text()
        except Exception:
            pass
    vals = parse_logind_text(text)
    # also merge drop-in explicitly (overrides)
    try:
        if Path(DROPIN_PATH).exists():
            vals.update(parse_logind_text(Path(DROPIN_PATH).read_text()))
    except Exception:
        pass

    # idle sec parsing to int seconds
    idle_sec_raw = vals.get("IdleActionSec", DEFAULTS["IdleActionSec"])
    sec = parse_sec(idle_sec_raw)
    return {
        "idleAction": vals.get("IdleAction", "ignore"),
        "idleActionSec": sec,
        "idleActionSecRaw": idle_sec_raw,
        "handleLidSwitch": vals.get("HandleLidSwitch", "suspend"),
        "handleLidSwitchExternalPower": vals.get("HandleLidSwitchExternalPower", "suspend"),
        "handleLidSwitchDocked": vals.get("HandleLidSwitchDocked", "ignore"),
        "handlePowerKey": vals.get("HandlePowerKey", "ignore"),
        "raw": vals,
    }

def parse_sec(s):
    s = s.strip()
    if s.isdigit():
        return int(s)
    m = re.match(r'^(\d+)\s*(s|sec|secs|m|min|mins|h|hour|hours)$', s, re.I)
    if m:
        n = int(m.group(1)); unit = m.group(2).lower()
        if unit.startswith("h"):
            return n * 3600
        if unit.startswith("m"):
            return n * 60
        return n
    # try "30min"
    m = re.match(r'^(\d+)\s*min$', s, re.I)
    if m:
        return int(m.group(1)) * 60
    try:
        return int(s)
    except Exception:
        return 1800

def format_sec(sec):
    if sec == 0:
        return "0"
    if sec % 3600 == 0:
        return f"{sec//3600}h"
    if sec % 60 == 0:
        return f"{sec//60}min"
    return f"{sec}s"

def write_dropin(idle_action, idle_sec, lid, lidExt, lidDocked):
    # validate
    if idle_action not in IDLE_ALLOWED:
        print(f"invalid idle action {idle_action}", file=sys.stderr); sys.exit(1)
    if lid not in LID_ALLOWED or lidExt not in LID_ALLOWED or lidDocked not in LID_ALLOWED:
        print("invalid lid action", file=sys.stderr); sys.exit(1)
    if not (0 <= idle_sec <= 7200):
        print("invalid idle sec", file=sys.stderr); sys.exit(1)
    content = f"""[Login]
# Generated by omarchy-power-managment — do not edit manually, use the plugin panel
HandleLidSwitch={lid}
HandleLidSwitchExternalPower={lidExt}
HandleLidSwitchDocked={lidDocked}
IdleAction={idle_action}
IdleActionSec={format_sec(idle_sec)}
"""
    # if we are root or can write directly, do it; else use pkexec
    needs_pkexec = not os.access(DROPIN_DIR, os.W_OK)
    # also check file writable
    if Path(DROPIN_PATH).exists() and not os.access(DROPIN_PATH, os.W_OK):
        needs_pkexec = True
    if needs_pkexec:
        # Secure: pipe content via stdin to pkexec, no user-owned temp file.
        # Previous version used mkstemp + cat "$tmp" which is TOCTOU-vulnerable:
        # same-UID attacker could replace tmp with symlink to root-only file
        # before pkexec cat, causing root to copy that file into 0644 drop-in.
        cmd = ["pkexec", "bash", "-c", f"mkdir -p {DROPIN_DIR} && cat > {DROPIN_PATH} && chmod 644 {DROPIN_PATH} && systemctl restart systemd-logind || true"]
        try:
            result = subprocess.run(cmd, input=content.encode(), timeout=20)
            if result.returncode != 0:
                print("pkexec failed or cancelled", file=sys.stderr)
                sys.exit(result.returncode)
        except subprocess.TimeoutExpired:
            print("pkexec timeout", file=sys.stderr); sys.exit(1)
    else:
        Path(DROPIN_DIR).mkdir(parents=True, exist_ok=True)
        Path(DROPIN_PATH).write_text(content)
        try:
            os.chmod(DROPIN_PATH, 0o644)
        except Exception:
            pass
        try:
            subprocess.run(["systemctl", "restart", "systemd-logind"], timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    print(json.dumps({"ok": True}))

def main():
    if len(sys.argv) < 2:
        print("usage: get|set-idle <action> <sec>|set-lid <lid> <ext> <docked>", file=sys.stderr)
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "get":
        eff = get_effective()
        print(json.dumps(eff))
        return
    if cmd == "set-idle":
        if len(sys.argv) != 4:
            print("need action sec", file=sys.stderr); sys.exit(1)
        action = sys.argv[2]; sec = int(sys.argv[3])
        cur = get_effective()
        write_dropin(action, sec, cur["handleLidSwitch"], cur["handleLidSwitchExternalPower"], cur["handleLidSwitchDocked"])
        return
    if cmd == "set-lid":
        if len(sys.argv) != 5:
            print("need lid ext docked", file=sys.stderr); sys.exit(1)
        lid, ext, dock = sys.argv[2], sys.argv[3], sys.argv[4]
        cur = get_effective()
        write_dropin(cur["idleAction"], cur["idleActionSec"], lid, ext, dock)
        return
    print(f"unknown {cmd}", file=sys.stderr); sys.exit(1)

if __name__ == "__main__":
    main()
