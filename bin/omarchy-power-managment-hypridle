#!/usr/bin/env python3
"""hypridle helper — get / set screensaver / displayOff / lock listeners.

Screensaver:  pidof hyprlock || omarchy-launch-screensaver
DisplayOff:   hyprctl dispatch dpms off  (with on-resume dpms on)
Lock:         omarchy-system-lock
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HYPRIDLE_PATH = Path.home() / ".config/hypr/hypridle.conf"
SHELL_JSON = Path.home() / ".config/omarchy/shell.json"
TOGGLES_DIR = Path.home() / ".local/state/omarchy/toggles"
SCREENSAVER_TOGGLE = TOGGLES_DIR / "screensaver-off"
SCREENSAVER_NEVER_SENTINEL = 31536000  # 1 year, effectively Never
SCREENSAVER_CMD = "omarchy-launch-screensaver"
LOCK_CMD = "omarchy-system-lock"
DPMS_OFF = "dpms off"
DPMS_ON = "dpms on"

def is_screensaver_disabled():
    try:
        return SCREENSAVER_TOGGLE.exists()
    except Exception:
        return False

def set_screensaver_toggle(disabled: bool):
    try:
        # Use omarchy-toggle if available, fallback to direct file
        if disabled:
            subprocess.run(["omarchy-toggle", "screensaver-off", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            if not SCREENSAVER_TOGGLE.exists():
                TOGGLES_DIR.mkdir(parents=True, exist_ok=True)
                SCREENSAVER_TOGGLE.touch(exist_ok=True)
        else:
            subprocess.run(["omarchy-toggle", "screensaver-off", "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            try:
                if SCREENSAVER_TOGGLE.exists():
                    SCREENSAVER_TOGGLE.unlink()
            except Exception:
                pass
    except Exception:
        pass

def is_hypridle_active():
    # Quattro uses omarchy-shell idle service, not hypridle binary.
    # Check omarchy-shell idle status, fallback to hypridle pgrep.
    try:
        out = subprocess.check_output(["omarchy-shell", "idle", "status"], text=True, timeout=3)
        j = json.loads(out)
        # idleEnabled true means backend active
        if "enabled" in j:
            return bool(j["enabled"])
        return True
    except Exception:
        pass
    try:
        subprocess.check_call(["pgrep", "-x", "hypridle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        try:
            out = subprocess.check_output(["systemctl", "--user", "is-active", "hypridle"], text=True).strip()
            return out == "active"
        except Exception:
            # If no hypridle, consider omarchy idle as active (Quattro default)
            return True

def parse_hypridle(text):
    """return dict with saver/display/lock secs and enabled flags."""
    # defaults
    saver = None
    display = None
    lock = None
    # find listeners
    # listener { timeout = 1800  on-timeout = ... }
    listener_re = re.compile(r'listener\s*\{([^}]*)\}', re.DOTALL)
    general_re = re.compile(r'general\s*\{([^}]*)\}', re.DOTALL)
    for m in listener_re.finditer(text):
        body = m.group(1)
        t = re.search(r'timeout\s*=\s*(\d+)', body)
        if not t:
            continue
        sec = int(t.group(1))
        on_timeout = re.search(r'on-timeout\s*=\s*(.+)', body)
        on_resume = re.search(r'on-resume\s*=\s*(.+)', body)
        cmd = on_timeout.group(1).strip() if on_timeout else ""
        resume = on_resume.group(1).strip() if on_resume else ""
        # strip comments
        cmd = cmd.split("#")[0].strip().strip('"').strip("'")
        # detection
        low = cmd.lower()
        if "screensaver" in low or "ttfx" in low:
            saver = sec
        elif "dpms" in low and "off" in low:
            display = sec
        elif "lock" in low or "hyprlock" in low:
            # avoid counting screensaver as lock
            if "screensaver" not in low:
                lock = sec
        # also handle dpms via hyprctl dispatch dpms
        # lock is omarchy-system-lock without screensaver
    return saver, display, lock

def read_shell_idle():
    try:
        if SHELL_JSON.exists():
            j = json.loads(SHELL_JSON.read_text())
            idle = j.get("idle", {})
            s = idle.get("screensaver")
            l = idle.get("lock")
            # shell idle uses int seconds directly
            try:
                s = int(s) if s is not None else None
            except Exception:
                s = None
            try:
                l = int(l) if l is not None else None
            except Exception:
                l = None
            return s, l
    except Exception:
        pass
    return None, None

def write_shell_idle(saver, lock):
    try:
        data = {}
        if SHELL_JSON.exists():
            try:
                data = json.loads(SHELL_JSON.read_text())
            except Exception:
                data = {}
        if "idle" not in data or not isinstance(data["idle"], dict):
            data["idle"] = {}
        if saver is not None:
            if int(saver) == 0:
                set_screensaver_toggle(True)
                # write sentinel large value to avoid IdleModel 0 immediate trigger
                data["idle"]["screensaver"] = SCREENSAVER_NEVER_SENTINEL
            else:
                set_screensaver_toggle(False)
                data["idle"]["screensaver"] = int(saver)
        if lock is not None:
            if int(lock) == 0:
                # No toggle for lock; use sentinel large value for Never
                data["idle"]["lock"] = SCREENSAVER_NEVER_SENTINEL
            else:
                data["idle"]["lock"] = int(lock)
        # atomic write
        SHELL_JSON.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(SHELL_JSON.parent), prefix="shell.json.tmp.")
        try:
            os.write(fd, json.dumps(data, indent=4).encode())
            os.fsync(fd)
            os.close(fd)
            os.rename(tmp, str(SHELL_JSON))
            os.chmod(str(SHELL_JSON), 0o600)
        finally:
            try:
                os.close(fd)
            except Exception:
                pass
            try:
                os.unlink(tmp)
            except Exception:
                pass
        return True
    except Exception as e:
        print(f"shell.json write failed: {e}", file=sys.stderr)
        return False

def get_state():
    saver, display, lock = None, None, None
    enabled_saver = True
    enabled_display = False
    enabled_lock = True
    # Prefer shell.json (Quattro) over hypridle.conf
    shell_saver, shell_lock = read_shell_idle()
    # Auto-fix legacy 0 values (immediate trigger) to sentinel + toggle
    if shell_saver == 0 and not is_screensaver_disabled():
        # Migrate legacy Never (0) to proper toggle + sentinel
        set_screensaver_toggle(True)
        write_shell_idle(0, None)
        shell_saver = SCREENSAVER_NEVER_SENTINEL
    if shell_lock == 0:
        # No toggle for lock, migrate to sentinel
        write_shell_idle(None, 0)
        shell_lock = SCREENSAVER_NEVER_SENTINEL
    if HYPRIDLE_PATH.exists():
        text = HYPRIDLE_PATH.read_text()
        saver, display, lock = parse_hypridle(text)
    # override with shell.json if present, but handle Never sentinel and toggle
    if is_screensaver_disabled():
        saver = 0
        enabled_saver = False
    elif shell_saver is not None:
        if shell_saver == SCREENSAVER_NEVER_SENTINEL:
            saver = 0
            enabled_saver = False
        else:
            saver = shell_saver
            enabled_saver = True
    if shell_lock is not None:
        if shell_lock == SCREENSAVER_NEVER_SENTINEL:
            lock = 0
            enabled_lock = False
        else:
            lock = shell_lock
            enabled_lock = True
    # defaults if missing
    if saver is None:
        saver = 1800
        enabled_saver = True
    if display is None:
        display = 0
        enabled_display = False
    else:
        enabled_display = display > 0
    if lock is None:
        lock = 2700
        enabled_lock = True
    if saver == 0:
        enabled_saver = False
    if lock == 0:
        enabled_lock = False
    return {
        "screensaverSec": saver,
        "displayOffSec": display,
        "lockSec": lock,
        "screensaverEnabled": enabled_saver,
        "displayOffEnabled": enabled_display,
        "lockEnabled": enabled_lock,
        "hypridleActive": is_hypridle_active(),
    }

def generate_hypridle(saver, display, lock):
    """Generate canonical hypridle.conf content."""
    lines = []
    lines.append("general {")
    lines.append("    lock_cmd = omarchy-system-lock                         # lock screen and 1password")
    lines.append("    before_sleep_cmd = OMARCHY_LOCK_ONLY=true omarchy-system-lock    # lock before suspend")
    lines.append("    after_sleep_cmd = sleep 1 && omarchy-system-wake")
    lines.append("    inhibit_sleep = 3")
    lines.append("}")
    lines.append("")
    if saver and saver > 0:
        lines.append("# Start screensaver")
        lines.append("listener {")
        lines.append(f"    timeout = {saver}")
        lines.append("    on-timeout = pidof hyprlock || omarchy-launch-screensaver")
        lines.append("}")
        lines.append("")
    if display and display > 0:
        lines.append("# Turn off display (DPMS)")
        lines.append("listener {")
        lines.append(f"    timeout = {display}")
        lines.append("    on-timeout = hyprctl dispatch dpms off")
        lines.append("    on-resume = hyprctl dispatch dpms on")
        lines.append("}")
        lines.append("")
    if lock and lock > 0:
        lines.append("# Lock system")
        lines.append("listener {")
        lines.append(f"    timeout = {lock}")
        lines.append("    on-timeout = omarchy-system-lock")
        lines.append("    on-resume = omarchy-system-wake")
        lines.append("}")
        lines.append("")
    # ensure trailing newline
    return "\n".join(lines)

def atomic_write(path: Path, content: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    # backup
    if path.exists():
        bak = path.with_suffix(path.suffix + ".bak")
        try:
            shutil.copy2(path, bak)
        except Exception:
            pass
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".tmp.")
    try:
        os.write(fd, content.encode())
        os.fsync(fd)
        os.close(fd)
        os.rename(tmp, path)
        # fsync dir
        try:
            dfd = os.open(str(path.parent), os.O_DIRECTORY)
            os.fsync(dfd)
            os.close(dfd)
        except Exception:
            pass
        os.chmod(path, 0o600)
    finally:
        try:
            os.close(fd)
        except Exception:
            pass
        try:
            os.unlink(tmp)
        except Exception:
            pass

def reload_hypridle():
    # try hyprctl reload, then systemctl --user restart hypridle, then pkill USR1
    for cmd in [
        ["hyprctl", "reload"],
        ["systemctl", "--user", "try-restart", "hypridle.service"],
        ["pkill", "-USR1", "hypridle"],
    ]:
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        except Exception:
            pass

def main():
    if len(sys.argv) < 2:
        print("usage: get|set-screensaver <sec>|set-displayoff <sec>|set-lock <sec>|set-all <s> <d> <l>", file=sys.stderr)
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "get":
        state = get_state()
        print(json.dumps(state))
        return
    # for set commands, need to read current then update one value
    state = get_state()
    saver = state["screensaverSec"]
    display = state["displayOffSec"]
    lock = state["lockSec"]
    if cmd == "set-screensaver":
        if len(sys.argv) != 3:
            print("need sec", file=sys.stderr); sys.exit(1)
        saver = int(sys.argv[2])
        if saver < 0 or saver > 7200:
            print("invalid value", file=sys.stderr); sys.exit(1)
    elif cmd == "set-displayoff":
        if len(sys.argv) != 3:
            print("need sec", file=sys.stderr); sys.exit(1)
        display = int(sys.argv[2])
        if display < 0 or display > 7200:
            print("invalid value", file=sys.stderr); sys.exit(1)
    elif cmd == "set-lock":
        if len(sys.argv) != 3:
            print("need sec", file=sys.stderr); sys.exit(1)
        lock = int(sys.argv[2])
        if lock < 0 or lock > 7200:
            print("invalid value", file=sys.stderr); sys.exit(1)
    elif cmd == "set-all":
        if len(sys.argv) != 5:
            print("need 3 values", file=sys.stderr); sys.exit(1)
        saver = int(sys.argv[2]); display = int(sys.argv[3]); lock = int(sys.argv[4])
        for v in (saver, display, lock):
            if v < 0 or v > 7200:
                print("invalid value", file=sys.stderr); sys.exit(1)
    else:
        print(f"unknown cmd {cmd}", file=sys.stderr); sys.exit(1)

    content = generate_hypridle(saver if saver != 0 else 0, display if display != 0 else 0, lock if lock != 0 else 0)
    atomic_write(HYPRIDLE_PATH, content)
    # also sync to shell.json (Quattro source of truth)
    write_shell_idle(saver if saver != 0 else 0, lock if lock != 0 else 0)
    reload_hypridle()
    # also trigger shell reload via rescan or signal? shell watches file
    try:
        subprocess.run(["omarchy-shell", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except Exception:
        pass
    print(json.dumps({"ok": True, "screensaverSec": saver, "displayOffSec": display, "lockSec": lock}))

if __name__ == "__main__":
    main()
